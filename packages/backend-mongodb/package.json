{
  "name": "@eosrio/hyperion-backend-mongodb",
  "version": "0.0.0-dev.1",
  "private": true,
  "description": "MongoDB execution adapter for Hyperion portable projections",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stateful": {"types": "./dist/stateful.d.ts", "import": "./dist/stateful.js"},
    "./stateful-owner-v2": {"types": "./dist/stateful-owner-v2.d.ts", "import": "./dist/stateful-owner-v2.js"},
    "./stateful-owner-complete-kind-v1": {"types": "./dist/stateful-complete-kind-v1.d.ts", "import": "./dist/stateful-complete-kind-v1.js"},
    "./stateful-owner-indexed-query-v1": {"types": "./dist/stateful-indexed-v1.d.ts", "import": "./dist/stateful-indexed-v1.js"},
    "./stateful-owner-indexed-query-v1/engineering": {"types": "./dist/stateful-indexed-engineering-v1.d.ts", "import": "./dist/stateful-indexed-engineering-v1.js"},
    "./operator-lists": {"types": "./dist/operator-lists.d.ts", "import": "./dist/operator-lists.js"}
  },
  "files": [
    "dist/",
    "README.md",
    "STATEFUL.md",
    "INDEXED-ENGINEERING.json",
    "OPERATOR-LISTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "bun check -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:package": "node scripts/check-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eosrio/hyperion-history-api.git",
    "directory": "packages/backend-mongodb"
  },
  "peerDependencies": {
    "@eosrio/hyperion-sdk": "0.0.0-dev.1"
  },
  "dependencies": {
    "mongodb": "7.2.0"
  },
  "devDependencies": {
    "@eosrio/hyperion-sdk": "git+https://github.com/eosrio/hyperion-sdk.git#dc20a03f2b60ba05a3369d677222a9cf0d65d299",
    "@types/node": "25.5.0",
    "typescript": "7.0.2"
  }
}
