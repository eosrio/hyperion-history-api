    "immutableSourceURL": "https://github.com/eosrio/hyperion-history-api/blob/7b53542111709cf8b225b381077e498e25bc5d61/.github/workflows/atomic-managed.yml",
    "historicalSource": "name: Managed Atomic MongoDB\non:\n  workflow_dispatch:\n  pull_request:\n    branches: [\"main\", \"test/indexed-native-mongodb-415\", \"feat/indexed-int64-tested-49dfe-20261104\"]\n    paths: [\"src/**\", \"packages/backend-mongodb/**\", \"scripts/qualification/atomic-managed/**\", \"tests/native/atomic-managed*\", \"package*.json\", \".github/workflows/atomic-managed.yml\"]\njobs:\n  managed-atomic:\n    runs-on: ubuntu-22.04\n    timeout-minutes: 15\n    strategy:\n      fail-fast: false\n      matrix:\n        node-version: [24.22.1, 26.4.0]\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/checkout@v4\n        with:\n          repository: eosrio/hyperion-atomicassets-plugin\n          ref: 1bc686bd7ed7d433b2cb7c3a04a762c0c832ad97\n          path: _qualification/atomic\n      - uses: actions/checkout@v4\n        with:\n          ref: c1b98a52a872b6c070ada32243c8286607e86883\n          path: _qualification/mixed\n      - uses: actions/setup-node@v4\n        with:\n          node-version: ${{ matrix.node-version }}\n      - uses: oven-sh/setup-bun@v2\n        with:\n          bun-version: 1.4.4\n      - run: npm ci --prefix packages/backend-mongodb --allow-git=all --ignore-scripts=false\n      - run: npm ci --allow-git=all\n      - run: npm ci --prefix _qualification/atomic --allow-git=all\n      - run: npm ci --prefix _qualification/mixed/packages/backend-mongodb --allow-git=all --ignore-scripts=false\n      - run: npm ci --prefix _qualification/mixed --allow-git=all\n      - run: npm run build\n      - run: npm run build --prefix _qualification/atomic\n      - run: npm run typecheck\n      - run: npm run typecheck --prefix _qualification/atomic\n      - name: Pure actual SDK and emitted managed publication controls\n        env:\n          HYPERION_ATOMIC_ROOT: ${{ github.workspace }}/_qualification/atomic\n          HYPERION_MIXED_ROOT: ${{ github.workspace }}/_qualification/mixed\n        run: node --test tests/native/atomic-managed-contract.test.mjs tests/native/atomic-managed-teardown.test.mjs tests/native/atomic-managed-host-publication.test.mjs tests/native/atomic-managed-result-observer.test.mjs tests/native/atomic-managed-sdk-boundary.test.mjs\n      - name: Owned controlled-source managed Atomic HTTP\n        run: node scripts/qualification/atomic-managed/ci.mjs --profile managed-atomic77-hapi-cbfb-linux-engineering-v1 _qualification/atomic out/managed-atomic-${{ matrix.node-version }}\n      - uses: actions/upload-artifact@v4\n        if: always()\n        with:\n          name: managed-atomic-${{ matrix.node-version }}\n          path: out/managed-atomic-${{ matrix.node-version }}\n          if-no-files-found: error\n",
